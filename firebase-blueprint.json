{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display name and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "defaultWorkspaceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Multi-user financial workspace",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "currency": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "currency", "createdAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Member of a financial workspace with roles and limits",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "EDITOR", "CONTRIBUTOR", "VIEWER"] },
        "dailySpendingLimit": { "type": "number" },
        "monthlySpendingLimit": { "type": "number" },
        "maxSingleTxAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "userId", "role", "createdAt"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial account such as Bank, Mobile Wallet, or Cash",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["BANK", "MOBILE_WALLET", "CASH", "SAVINGS", "OTHER"] },
        "providerName": { "type": "string" },
        "accountNumberMasked": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "name", "type", "openingBalance", "currentBalance", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income, expense, transfer, or balance adjustment",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE", "TRANSFER", "ADJUSTMENT"] },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "toAccountId": { "type": "string" },
        "toAccountName": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "isReversed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "type", "title", "amount", "accountId", "date", "createdBy", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Income and expense categories",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "name", "type", "createdAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly or periodic budgets",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "spentAmount": { "type": "number" },
        "period": { "type": "string", "enum": ["MONTHLY", "WEEKLY", "YEARLY"] },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "name", "amount", "period", "createdAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Savings target and progress tracking",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "savedAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "title", "targetAmount", "savedAmount", "status", "createdAt"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Receivables and Payables (Loan/Lent)",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "personName": { "type": "string" },
        "type": { "type": "string", "enum": ["RECEIVABLE", "PAYABLE"] },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "PARTIAL", "COMPLETED"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "personName", "type", "amount", "paidAmount", "status", "createdAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Recurring income and expense schedules",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
        "frequency": { "type": "string", "enum": ["DAILY", "WEEKLY", "MONTHLY", "YEARLY"] },
        "accountId": { "type": "string" },
        "categoryId": { "type": "string" },
        "nextExecutionDate": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "title", "amount", "type", "frequency", "accountId", "isActive", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit log of user actions",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "actionType": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "userId", "actionType", "entityType", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Workspaces"
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Workspace members"
    },
    "/workspaces/{workspaceId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Accounts"
    },
    "/workspaces/{workspaceId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transactions"
    },
    "/workspaces/{workspaceId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories"
    },
    "/workspaces/{workspaceId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Budgets"
    },
    "/workspaces/{workspaceId}/savingsGoals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "Savings Goals"
    },
    "/workspaces/{workspaceId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/Debt" },
      "description": "Loans and Debts"
    },
    "/workspaces/{workspaceId}/recurring/{recurringId}": {
      "schema": { "$ref": "#/entities/RecurringTransaction" },
      "description": "Recurring Transactions"
    },
    "/workspaces/{workspaceId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit Logs"
    }
  }
}
